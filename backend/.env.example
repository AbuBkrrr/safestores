# Copy this file to .env and fill in real values
#
# ============================================================
# DEPLOYMENT PATH — pick one, both are fully supported:
#   1. Traditional (server.js): an always-on Node process on Render, Fly,
#      a VPS, your own box, etc. Full realtime (Socket.IO) support.
#   2. Serverless (netlify/functions/): Netlify Functions + any Postgres,
#      including Supabase. No realtime — see netlify/functions/api.js's
#      header for what that means in practice (small, and non-critical).
# Everything below applies to both; a few settings only matter for #2,
# marked "(serverless only)".
# ============================================================

# Set to "production" on your deployed host — this switches on stricter
# CORS enforcement, SSL for the database connection, and combined-format
# access logs. Leave unset for local development.
NODE_ENV=production

PORT=4000

# PostgreSQL connection. Works with any Postgres — self-hosted, Render,
# Railway, Neon, RDS, or Supabase (a Supabase project's own Postgres
# connection string works here unmodified; no Supabase-specific client
# library is used anywhere in this codebase).
#
# (serverless only) If deploying via Netlify Functions against Supabase,
# use Supabase's connection pooler URL (port 6543, "Transaction" mode in
# their dashboard), not the direct connection (port 5432) — every function
# invocation is a fresh process with its own connection pool, and the
# pooler is what keeps that from exhausting Postgres's own connection
# limit. This is safe here specifically because none of this codebase's
# queries use named prepared statements (a common PgBouncer transaction-
# mode incompatibility) — they're all plain parameterized queries.
DATABASE_URL=postgres://user:password@your-db-host:5432/safestores

# Most hosted Postgres (Render, Railway, Supabase, Neon, RDS) requires SSL.
# Set to "require" if your provider needs it (check their connection docs).
# Automatically enabled when NODE_ENV=production even if left unset here.
DATABASE_SSL=require
# (serverless only) Keep this LOW (1-2) when deploying via Netlify
# Functions — a high value multiplies fast under concurrent invocations,
# since each cold start gets its own pool. The traditional server.js
# deployment is a single long-lived process, so its default of 10 is fine.
DB_POOL_MAX=10

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - the origin(s) your frontend is served from. Comma-separate multiple
# origins (e.g. a production domain and a staging one) with no spaces:
# FRONTEND_URL=https://safestores.name.ng,https://staging.safestores.name.ng
# REQUIRED when NODE_ENV=production — the server refuses to start without it.
FRONTEND_URL=http://localhost:5173

# Optional: bootstrap the very first super admin on first server start
# (only used if the super_admins table is empty)
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=super@safestores.name.ng
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeMe123!

# File uploads (receipts / camera captures).
#
# LOCAL DISK (default): stored in /uploads and served statically. Fine for
# local dev, but most PaaS hosts (Render, Railway, Fly) use an EPHEMERAL
# filesystem — every uploaded receipt/camera photo disappears on the next
# redeploy or restart unless you attach a persistent volume.
#
# (serverless only) On Netlify Functions this isn't just risky, it's
# broken outright: there's no disk that persists between invocations at
# all, not even within the same deploy. S3_BUCKET below is effectively
# REQUIRED for the serverless deployment path, not just recommended.
UPLOAD_DIR=uploads

# S3-COMPATIBLE OBJECT STORAGE (recommended for production): set S3_BUCKET
# to switch automatically — uploads go straight to durable storage and
# survive redeploys/restarts. Works with real AWS S3 or any S3-compatible
# provider (Cloudflare R2, Backblaze B2, DigitalOcean Spaces, MinIO, etc.)
# S3_BUCKET=my-safestores-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Only needed for non-AWS providers (R2/Spaces/B2/MinIO):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# Only set if your bucket actually needs/accepts ACLs (many modern buckets,
# including R2 and buckets with "Bucket owner enforced", reject this):
# S3_ACL=public-read
# Override the public URL base if serving through a CDN/custom domain
# instead of the provider's default object URL:
# S3_PUBLIC_URL_BASE=https://cdn.example.com

# Transactional email (support-ticket notifications, and emailing the
# Reports page's inventory snapshot to an admin/manager on request). Works
# REQUIRED FOR LAUNCH since v26: password-reset links, email verification
# and the 9 pm daily summary are all sent by email. Without SMTP those
# features quietly do nothing (admins can still set staff passwords).
# Works with any SMTP provider — SendGrid, Mailgun, Postmark, Amazon SES, Resend,
# or a plain Gmail/Workspace SMTP relay. Leave unset to skip email entirely
# (support tickets still work fully in-app, and Reports' "Email Report"
# button falls back to opening the user's own mail app instead).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=
# SMTP_FROM="SAFE Stores <no-reply@yourdomain.com>"

# Where new/replied-to support tickets get emailed (in addition to always
# being visible in-app under Super Admin > Support). Leave unset to rely on
# in-app only.
# SUPPORT_INBOX_EMAIL=support@yourdomain.com

# OCR (receipt scanning) uses Tesseract.js, which runs locally and needs no
# API key. On first use it downloads the English trained-data model (~10-15MB)
# from Tesseract's CDN, so the server needs outbound internet access once.
# To avoid that at runtime (e.g. air-gapped deployments), pre-download
# eng.traineddata and point this at the folder containing it. Leave unset
# to use the default CDN-fetched model.
# TESSDATA_PATH=/path/to/tessdata

# Error monitoring (Sentry). Get a free DSN at sentry.io — leave unset to
# run without error monitoring entirely (the app works fine either way;
# you just won't be notified when something breaks in production). See
# src/utils/errorMonitoring.js for exactly what this does and doesn't do.
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# Paystack (online billing payments). Once a Super Admin sets the payment
# gateway to "paystack" and turns it on in Payment Settings, store admins
# get a "Pay Online Now" button on their Billing page alongside the manual
# bank-transfer flow. Leave unset to skip online payment entirely — manual
# bank transfer + claim/confirm keeps working exactly as before regardless.
# Get these from your Paystack dashboard (Settings > API Keys & Webhooks).
# Also add https://yourdomain.com/api/webhooks/paystack there as a webhook
# URL so payments are confirmed even if a customer's browser never makes
# it back to the app after paying (see paymentWebhookController.js).
# PAYSTACK_SECRET_KEY=sk_live_xxxx
# PAYSTACK_PUBLIC_KEY=pk_live_xxxx

# ------------------------------------------------------------
# STOREFRONT ONLINE PAYMENTS (Paystack split payments)
# Shopper payments settle straight to each store's own bank account via a
# Paystack subaccount — the platform never holds them. Requires
# PAYSTACK_SECRET_KEY (also used for subscription charges).
# PAYSTACK_CURRENCIES: what your Paystack account can collect (one country).
# Commission, balance limit and netting are set in Super Admin → Store Settlements.
# ------------------------------------------------------------
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_CURRENCIES=NGN
