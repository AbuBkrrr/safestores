# Copy to .env if you need to point at a non-default API URL in production.
# In local dev, Vite's proxy (see vite.config.js) forwards /api to localhost:4000
# so this isn't required.
VITE_API_URL=

# Optional (build time): Sentry DSN for frontend error reports.
# VITE_SENTRY_DSN=

# Legal pages (/terms, /privacy): the operator's legal name, contact email
# and governing law. Have the texts in src/pages/Legal.jsx reviewed by a
# lawyer before launch.
# VITE_LEGAL_ENTITY=A I Brains Ventures
# VITE_LEGAL_CONTACT=support@safestores.name.ng
# VITE_LEGAL_COUNTRY=the Federal Republic of Nigeria
