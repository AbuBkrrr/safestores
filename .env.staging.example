# Copy this file to .env (same directory as docker-compose.yml) and fill
# in real values. .env is gitignored — never commit the filled-in version.
#
# This is a MINIMAL set for docker-compose.yml's staging stack. For every
# other backend option (S3 uploads, SMTP email, etc.) see
# backend/.env.example — those go in backend's own .env if you're running
# it outside Docker, or as additional `environment:` entries under the
# `backend` service in docker-compose.yml if running it inside Docker.

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The public URL the frontend will actually be reached at (used for CORS).
# For a bare docker-compose staging box: http://<server-ip>:8080
# For a real domain behind a reverse proxy/TLS terminator: https://safestores.name.ng
# (registered domain as of this writing — subject to change; this is the
# ONLY place a real deployment needs to set it, since every other part of
# the app reads FRONTEND_URL from the environment rather than hardcoding it)
FRONTEND_URL=http://localhost:8080

# Optional — leave blank to run without error monitoring. See
# backend/src/utils/errorMonitoring.js for what this enables.
SENTRY_DSN=
